# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# room PDF uploads (local dev; production may use Azure only)
/uploads

# FFmpeg WASM assets (copied by scripts/copy-ffmpeg-core.mjs on postinstall)
/public/ffmpeg/ffmpeg-core.js
/public/ffmpeg/ffmpeg-core.wasm
/public/ffmpeg/worker.js
/public/ffmpeg/const.js
/public/ffmpeg/errors.js

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
